# Supabase — copy to .env.local and fill in from Settings → API in the dashboard.

# Project URL + PUBLIC anon key. Safe in the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. Bypasses RLS. Never expose to the browser or commit a real value.
# Used by admin/server routes (onboarding submit, approval/rejection, apply-links).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signing secret for tracked email apply-links (plan §8a). Shared with the radar.
APP_LINK_SECRET=generate-a-long-random-string

# Gmail SMTP for outbound app mail (onboarding notice, approval). Same account
# as Supabase Auth SMTP. GMAIL_APP_PASSWORD is a Google App Password, not the
# account password. ADMIN_EMAIL receives onboarding submissions (defaults to GMAIL_USER).
GMAIL_USER=your-project-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
ADMIN_EMAIL=your-project-address@gmail.com
